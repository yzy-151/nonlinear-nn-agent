<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="nonlinear-agent-system" name="System Overview"><mxGraphModel dx="3200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;NONLINEAR NN AGENT · 端到端 Agent Harness 系统总览&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:20px'&gt;从自然语言目标到受控代码生成、真实训练、反思重规划与可审计证据&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#152536;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="1900" height="95" as="geometry" /></mxCell><mxCell id="z_entry" value="&lt;b&gt;01 交付入口 / Delivery&lt;/b&gt;" style="swimlane;html=1;startSize=58;horizontal=1;rounded=1;arcSize=2;fillColor=#F7FAFC;swimlaneFillColor=#FFFFFF;strokeColor=#B9C5D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#253647;align=left;spacingLeft=16;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="340" height="1180" as="geometry" /></mxCell><mxCell id="z_modes" value="&lt;b&gt;02 运行模式 / Modes&lt;/b&gt;" style="swimlane;html=1;startSize=58;horizontal=1;rounded=1;arcSize=2;fillColor=#F7FAFC;swimlaneFillColor=#FFFFFF;strokeColor=#B9C5D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#253647;align=left;spacingLeft=16;collapsible=0;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="400" height="1180" as="geometry" /></mxCell><mxCell id="z_core" value="&lt;b&gt;03 智能编排核心 / Agentic Orchestration&lt;/b&gt;" style="swimlane;html=1;startSize=58;horizontal=1;rounded=1;arcSize=2;fillColor=#FBF9FF;swimlaneFillColor=#FFFFFF;strokeColor=#C9BAEE;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#253647;align=left;spacingLeft=16;collapsible=0;" vertex="1" parent="1"><mxGeometry x="840" y="180" width="1100" height="680" as="geometry" /></mxCell><mxCell id="z_context" value="&lt;b&gt;04 上下文系统 / Knowledge &amp; Memory&lt;/b&gt;" style="swimlane;html=1;startSize=58;horizontal=1;rounded=1;arcSize=2;fillColor=#F5F8FB;swimlaneFillColor=#FFFFFF;strokeColor=#AAB9C7;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#253647;align=left;spacingLeft=16;collapsible=0;" vertex="1" parent="1"><mxGeometry x="840" y="880" width="1100" height="480" as="geometry" /></mxCell><mxCell id="z_exec" value="&lt;b&gt;05 受控实验执行 / Controlled Runtime&lt;/b&gt;" style="swimlane;html=1;startSize=58;horizontal=1;rounded=1;arcSize=2;fillColor=#F8FBFE;swimlaneFillColor=#FFFFFF;strokeColor=#AFC8DF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#253647;align=left;spacingLeft=16;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1960" y="180" width="540" height="1180" as="geometry" /></mxCell><mxCell id="z_evidence" value="&lt;b&gt;06 证据与可观测性 / Evidence&lt;/b&gt;" style="swimlane;html=1;startSize=58;horizontal=1;rounded=1;arcSize=2;fillColor=#F7FCF9;swimlaneFillColor=#FFFFFF;strokeColor=#A8CFBF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#253647;align=left;spacingLeft=16;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2520" y="180" width="620" height="1180" as="geometry" /></mxCell><mxCell id="goal" value="&lt;b&gt;用户目标与约束&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;goal · domain · dataset&lt;br&gt;budget · target · whitelist&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8794A1;strokeWidth=3;fontColor=#263442;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="280" height="110" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;Web Operations Console&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;Multi-Agent + 受控搜索&lt;br&gt;Timeline / Inspector&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="435" width="280" height="100" as="geometry" /></mxCell><mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;run / multi-agent&lt;br&gt;benchmark / compare&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="280" height="100" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;HTTP + SSE API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;stream · replay · cancel&lt;br&gt;safe event projection&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="685" width="280" height="100" as="geometry" /></mxCell><mxCell id="mcp" value="&lt;b&gt;MCP Bridge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;结构化工具入口&lt;br&gt;复用 Runtime / Registry&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="810" width="280" height="100" as="geometry" /></mxCell><mxCell id="delivery_contract" value="&lt;b&gt;统一交付契约&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;输入：GoalSpec / budgets&lt;br&gt;输出：TraceEvent / artifacts&lt;br&gt;密钥与源码不进入事件流&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#C28316;strokeWidth=3;fontColor=#60420C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="1030" width="280" height="170" as="geometry" /></mxCell><mxCell id="multi" value="&lt;b&gt;Multi-Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;Idea / Coding / Execute&lt;br&gt;Writing / Supervisor&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="285" width="340" height="115" as="geometry" /></mxCell><mxCell id="planner_loop" value="&lt;b&gt;受控搜索 / Agent Loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;模型 + 参数双白名单&lt;br&gt;plan → metric → facts → replan&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="435" width="340" height="115" as="geometry" /></mxCell><mxCell id="fixed" value="&lt;b&gt;Fixed Workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;确定性步骤编排&lt;br&gt;scripted / offline&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="585" width="340" height="105" as="geometry" /></mxCell><mxCell id="benchmark_mode" value="&lt;b&gt;Benchmark / Comparison&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;10+ cases · strategies&lt;br&gt;same protocol / evaluator&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#258466;strokeWidth=3;fontColor=#124D3B;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="725" width="340" height="120" as="geometry" /></mxCell><mxCell id="shared" value="&lt;b&gt;共享 Harness 基础&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Runtime · ToolRegistry&lt;br&gt;Guard · Trace · Session&lt;br&gt;同一生产链路，不旁路&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="1040" width="340" height="165" as="geometry" /></mxCell><mxCell id="budget" value="&lt;b&gt;Supervisor + Budget Controller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;round / experiment / token / cost / timeout&lt;br&gt;single terminal · cancellation checkpoint&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#C28316;strokeWidth=3;fontColor=#60420C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="265" width="1020" height="90" as="geometry" /></mxCell><mxCell id="idea" value="&lt;b&gt;1  Idea / Plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;提出 hypothesis&lt;br&gt;输出结构化 plan&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=17;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="420" width="160" height="140" as="geometry" /></mxCell><mxCell id="plan_gate" value="&lt;b&gt;2  PlanGate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;验证引用/约束&lt;br&gt;validated / rejected&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#C28316;strokeWidth=3;fontColor=#60420C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1040" y="420" width="160" height="140" as="geometry" /></mxCell><mxCell id="coding" value="&lt;b&gt;3  CodingAgent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;完整 candidate package&lt;br&gt;ModelRouter(coding)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=17;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1215" y="420" width="160" height="140" as="geometry" /></mxCell><mxCell id="execution" value="&lt;b&gt;4  ExecutionAgent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;只发 ToolCall&lt;br&gt;不直接执行 shell&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=14;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1390" y="420" width="160" height="140" as="geometry" /></mxCell><mxCell id="writing" value="&lt;b&gt;5  WritingAgent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;只读 EvidenceBundle&lt;br&gt;citation fidelity gate&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=16;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1565" y="420" width="160" height="140" as="geometry" /></mxCell><mxCell id="terminal" value="&lt;b&gt;6  Terminal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;completed / failed&lt;br&gt;cancelled / budget&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#258466;strokeWidth=3;fontColor=#124D3B;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1740" y="420" width="160" height="140" as="geometry" /></mxCell><mxCell id="facts" value="&lt;b&gt;确定性 Reflection&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;仅提取 metrics / failure facts&lt;br&gt;不输出下一步策略&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#C94B4B;strokeWidth=3;fontColor=#672626;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="970" y="650" width="330" height="115" as="geometry" /></mxCell><mxCell id="replan" value="&lt;b&gt;有限 Replan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;下一轮 LLM 读取干净事实&lt;br&gt;选择新策略&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="650" width="300" height="115" as="geometry" /></mxCell><mxCell id="cancel" value="&lt;b&gt;终止条件&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;cancel / non-retryable&lt;br&gt;budget exceeded&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#C28316;strokeWidth=3;fontColor=#60420C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1690" y="650" width="210" height="115" as="geometry" /></mxCell><mxCell id="knowledge_docs" value="&lt;b&gt;白名单知识文档&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;docs/knowledge/...&lt;br&gt;hash + version&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8794A1;strokeWidth=3;fontColor=#263442;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="875" y="1005" width="185" height="120" as="geometry" /></mxCell><mxCell id="ingestor" value="&lt;b&gt;KnowledgeIngestor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;chunk / citation&lt;br&gt;source provenance&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=16;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1080" y="1005" width="185" height="120" as="geometry" /></mxCell><mxCell id="retrieval" value="&lt;b&gt;Hybrid Retrieval&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;BM25 + vector&lt;br&gt;rerank + top-k&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=17;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1285" y="1005" width="185" height="120" as="geometry" /></mxCell><mxCell id="context_builder" value="&lt;b&gt;PlannerContextBuilder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Goal + facts + best&lt;br&gt;EvidenceChunk allowlist&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1490" y="1005" width="190" height="120" as="geometry" /></mxCell><mxCell id="memory" value="&lt;b&gt;Typed Memory&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;semantic / episodic&lt;br&gt;procedural + namespace&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1700" y="1005" width="195" height="120" as="geometry" /></mxCell><mxCell id="context_truth" value="&lt;b&gt;当前真实性边界&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;CLI / Action Loop 与 Multi-Agent：top-k 检索、引用校验、provenance 已接通&lt;br&gt;本地默认进程内 Memory；持久化部署可切换 Postgres backend&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=18;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="875" y="1190" width="1020" height="105" as="geome