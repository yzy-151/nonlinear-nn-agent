<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="nonlinear-agent-executive" name="Executive Overview"><mxGraphModel dx="2400" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="exec_title" value="&lt;b&gt;NONLINEAR NN AGENT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:18px'&gt;让 Agent 自主设计实验，同时把代码执行、训练、评测与报告约束在可审计的工程闭环中&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=34;fontColor=#172C3D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="35" width="900" height="105" as="geometry" /></mxCell><mxCell id="kpi_rounds" value="&lt;b&gt;3 rounds&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;9 search experiments&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=2;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=22;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="290" height="120" as="geometry" /></mxCell><mxCell id="kpi_completed" value="&lt;b&gt;8 / 9&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;completed with failure isolation&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#258466;strokeWidth=2;fontColor=#124D3B;fontFamily=Segoe UI;fontSize=22;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="1350" y="130" width="330" height="120" as="geometry" /></mxCell><mxCell id="kpi_best" value="&lt;b&gt;24 params&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;best candidate package&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#258466;strokeWidth=2;fontColor=#124D3B;fontFamily=Segoe UI;fontSize=22;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="1700" y="130" width="300" height="120" as="geometry" /></mxCell><mxCell id="kpi_truth" value="&lt;b&gt;−23.0778 dB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;target −41 dB not hit&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#C94B4B;strokeWidth=2;fontColor=#672626;fontFamily=Segoe UI;fontSize=22;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="2020" y="130" width="300" height="120" as="geometry" /></mxCell><mxCell id="exec_goal" value="&lt;b&gt;01 业务目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;输入实验目标与约束&lt;br&gt;模型 / 参数 / 时间预算&lt;br&gt;自动寻找可验证候选&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8794A1;strokeWidth=3;fontColor=#263442;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="360" height="250" as="geometry" /></mxCell><mxCell id="exec_team" value="&lt;b&gt;02 Multi-Agent 团队&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;Plan：提出实验假设&lt;br&gt;Code：生成完整候选包&lt;br&gt;Run：执行真实训练&lt;br&gt;Write：形成证据报告&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="535" y="330" width="390" height="250" as="geometry" /></mxCell><mxCell id="exec_harness" value="&lt;b&gt;03 Agent Harness 护栏&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;PlanGate + Schema / AST&lt;br&gt;ToolRegistry + 隔离 Worktree&lt;br&gt;预算、超时、取消与唯一终态&lt;br&gt;LLM 不直接操作 shell&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#C28316;strokeWidth=3;fontColor=#60420C;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="410" height="250" as="geometry" /></mxCell><mxCell id="exec_loop" value="&lt;b&gt;04 实验闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;真实 Train + 独立 Evaluator&lt;br&gt;NMSE / PSD / 参数量复核&lt;br&gt;失败提取为干净事实&lt;br&gt;下一轮 LLM 重新规划&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDF6FF;strokeColor=#3478B9;strokeWidth=3;fontColor=#173D5C;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1525" y="330" width="390" height="250" as="geometry" /></mxCell><mxCell id="exec_delivery" value="&lt;b&gt;05 证据交付&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;Trace / SSE / Inspector&lt;br&gt;HTML / PDF / Dashboard&lt;br&gt;Benchmark + 95% CI&lt;br&gt;结果与过程均可审计&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#258466;strokeWidth=3;fontColor=#124D3B;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="2010" y="330" width="310" height="250" as="geometry" /></mxCell><mxCell id="proof_autonomy" value="&lt;b&gt;自主实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;LLM 设计、编码、执行、汇总&lt;br&gt;跨轮消费验证后的失败事实&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#7557C5;strokeWidth=3;fontColor=#30245B;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="520" height="190" as="geometry" /></mxCell><mxCell id="proof_control" value="&lt;b&gt;工程控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;受控工具调用与隔离执行&lt;br&gt;预算、幂等、取消、失败收口&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#C28316;strokeWidth=3;fontColor=#60420C;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="650" y="760" width="520" height="190" as="geometry" /></mxCell><mxCell id="proof_evidence" value="&lt;b&gt;可信证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;Evaluator 复核有限指标&lt;br&gt;报告只能引用 EvidenceBundle&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#258466;strokeWidth=3;fontColor=#124D3B;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1220" y="760" width="520" height="190" as="geometry" /></mxCell><mxCell id="proof_boundary" value="&lt;b&gt;真实边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;Agent 工程闭环已经验证&lt;br&gt;算法性能超过历史先验尚未验证&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#C94B4B;strokeWidth=3;fontColor=#672626;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1790" y="760" width="530" height="190" as="geometry" /></mxCell><mxCell id="exec_flow_1" value="" edge="1" parent="1" source="exec_goal" target="exec_team" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B7FA5;strokeWidth=5;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="exec_flow_2" value="" edge="1" parent="1" source="exec_team" target="exec_harness" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B7FA5;strokeWidth=5;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="exec_flow_3" value="" edge="1" parent="1" source="exec_harness" target="exec_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B7FA5;strokeWidth=5;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="exec_flow_4" value="" edge="1" parent="1" source="exec_loop" target="exec_delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B7FA5;strokeWidth=5;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="exec_feedback" value="verified metrics + failure facts → next plan" edge="1" parent="1" source="exec_loop" target="exec_team" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A67B5;strokeWidth=4;dashed=1;dashPattern=10 8;endArrow=block;endFill=1;fontColor=#7656A0;fontSize=16;labelBackgroundColor=#F8FAFC;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1720" y="660" /><mxPoint x="730" y="660" /></Array></mxGeometry></mxCell><mxCell id="exec_summary" value="&lt;b&gt;领导视角的一句话&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:18px'&gt;这不是一个只会调用训练脚本的工作流，而是一套把 LLM 决策、代码生成、受控执行、错误恢复和证据交付连接起来的 Agent Harness。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#8B3E3E' style='font-size:16px'&gt;当前价值集中在工程闭环与可观测性；真实 3×3 运行完成了 8 个候选，但 −23.08 dB 未达到 −41 dB 目标。&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AFC0CD;strokeWidth=2;fontColor=#20384B;fontFamily=Segoe UI;fontSize=20;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1"><mxGeometry x="80" y="1025" width="2240" height="220" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>